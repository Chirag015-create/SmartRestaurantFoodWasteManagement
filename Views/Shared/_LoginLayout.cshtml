<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SmartWaste</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="~/Content/Site.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at 20% 20%, rgba(25,135,84,.15), transparent 50%), radial-gradient(circle at 80% 80%, rgba(59,130,246,.12), transparent 50%), #0b0f14;
            /* ❌ REMOVE the display:flex / align-items:center — those broke the layout */
        }

        /* This centers the login card vertically & horizontally, the Bootstrap way */
        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

            .login-wrapper > .container {
                width: 100%;
                max-width: 100%; /* let Bootstrap grid control widths */
            }

        .bg-emerald-dark {
            background: linear-gradient(135deg, #0f5132 0%, #146c43 100%) !important;
            border-bottom: 1px solid rgba(255,255,255,.08) !important;
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="container">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>