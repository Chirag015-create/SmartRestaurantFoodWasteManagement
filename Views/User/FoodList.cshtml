@model IEnumerable<SmartRestaurantWasteManagement.Models.Food>
@{
    ViewBag.Title = "Food Inventory List";
}

<div class="glass-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2><i class="fa-solid fa-list-check"></i> Master Food Items List</h2>
        <a href="@Url.Action("AddFood", "User")" class="btn-primary-custom"><i class="fa-solid fa-plus"></i> Add Item</a>
    </div>

    <table class="table-custom">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Unit</th>
                <th>Shelf Life</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.FoodId</td>
                        <td><strong>@item.Name</strong></td>
                        <td><span class="badge-custom badge-info">@item.Category</span></td>
                        <td>$@item.Price.ToString("F2")</td>
                        <td>@item.Unit</td>
                        <td>@item.ShelfLifeDays Days</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge-custom badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-custom badge-danger">Inactive</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align: center; color: var(--text-muted);">No food items found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
