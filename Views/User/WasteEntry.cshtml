@model SmartRestaurantWasteManagement.Models.Waste
@{
    ViewBag.Title = "Log Waste Entry";
}

<div style="max-width: 600px; margin: 2rem auto;">
    <div class="glass-card">
        <h2 style="margin-bottom: 1.5rem;"><i class="fa-solid fa-trash-can-arrow-up"></i> Log Waste Record</h2>

        @using (Html.BeginForm("WasteEntry", "User", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Select Food Item</label>
                @Html.DropDownListFor(m => m.FoodId, (SelectList)ViewBag.Foods, "-- Select Food --", new { @class = "form-control-custom", required = "required" })
            </div>
            <div class="form-group">
                <label class="form-label">Quantity Wasted</label>
                @Html.TextBoxFor(m => m.QuantityWasted, new { @class = "form-control-custom", type = "number", step = "0.1", placeholder = "5.0", required = "required" })
            </div>
            <div class="form-group">
                <label class="form-label">Unit</label>
                @Html.TextBoxFor(m => m.Unit, new { @class = "form-control-custom", placeholder = "Kg / Portions / Plates", required = "required" })
            </div>
            <div class="form-group">
                <label class="form-label">Reason for Waste</label>
                @Html.DropDownListFor(m => m.Reason, new SelectList(new[] { "Expired", "Over-prepared", "Spoiled/Damaged", "Customer Plate Leftover", "Storage Defect" }), "-- Select Reason --", new { @class = "form-control-custom", required = "required" })
            </div>
            <button type="submit" class="btn-primary-custom" style="width: 100%; justify-content: center; margin-top: 1rem;">
                Submit Waste Log
            </button>
        }
    </div>
</div>
