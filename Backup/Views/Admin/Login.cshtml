@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Admin Authentication";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card bg-dark text-light border-danger shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-gradient bg-danger-dark text-center py-4 border-danger">
                <div class="display-6 text-danger mb-2">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <h3 class="fw-bold mb-1">Admin Portal Login</h3>
                <p class="text-secondary small mb-0">System Administrator Control Center</p>
            </div>
            
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <i class="fa-solid fa-circle-exclamation flex-shrink-0"></i>
                        <div>@ViewBag.Error</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label for="email" class="form-label text-light fw-medium">
                            <i class="fa-solid fa-user-gear me-1 text-danger"></i> Administrator Email
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary border-secondary text-light">@("@")</span>
                            <input type="email" id="email" name="email" class="form-control bg-body-tertiary text-light border-secondary" placeholder="admin@smartresto.com" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label text-light fw-medium mb-1">
                            <i class="fa-solid fa-key me-1 text-danger"></i> Master Key / Password
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary border-secondary text-light"><i class="fa-solid fa-lock"></i></span>
                            <input type="password" id="password" name="password" class="form-control bg-body-tertiary text-light border-secondary" placeholder="••••••••" required />
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg fw-semibold shadow-sm">
                            <i class="fa-solid fa-shield-halved me-2"></i> Access Admin Console
                        </button>
                    </div>
                }
            </div>
            
            <div class="card-footer bg-body-tertiary border-danger text-center py-3">
                <small class="text-secondary">Demo Admin: <code>admin@smartresto.com</code> / <code>admin123</code></small>
            </div>
        </div>
    </div>
</div>
