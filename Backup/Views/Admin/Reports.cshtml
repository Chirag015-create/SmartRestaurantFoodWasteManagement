@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Admin System Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-danger-subtle">
    <div>
        <h2 class="fw-bold mb-1 text-light">
            <i class="fa-solid fa-file-invoice-dollar text-danger me-2"></i>Global System Audit Reports
        </h2>
        <p class="text-secondary mb-0">System-wide waste telemetry, food preparation efficiency, and financial loss metrics.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Active Staff Accounts</span>
                    <h2 class="display-6 fw-bold mb-0 text-info">@ViewBag.TotalUsers</h2>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                    <i class="fa-solid fa-users fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Total Registered Foods</span>
                    <h2 class="display-6 fw-bold mb-0 text-success">@ViewBag.TotalFoods</h2>
                </div>
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="fa-solid fa-utensils fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-4">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Audit Waste Logs</span>
                    <h2 class="display-6 fw-bold mb-0 text-warning">@ViewBag.TotalWasteLogs</h2>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="fa-solid fa-dumpster fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-header bg-body-tertiary border-secondary py-3">
        <h5 class="card-title mb-0 text-light fw-semibold"><i class="fa-solid fa-chart-line me-2 text-primary"></i>System Health & Analytics Summary</h5>
    </div>
    <div class="card-body">
        <p class="text-secondary mb-3">All system logs, food items, and waste tracking metrics are actively synchronized with SQL Server LocalDB.</p>
        <div class="alert alert-success bg-success bg-opacity-10 border-success text-success mb-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-check-circle"></i>
            <div>Audit logging & reporting engines are active and reporting no errors.</div>
        </div>
    </div>
</div>
