@model IEnumerable<SmartRestaurantWasteManagement.Models.Food>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Admin - Manage Foods";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-danger-subtle">
    <div>
        <h2 class="fw-bold mb-1 text-light">
            <i class="fa-solid fa-layer-group text-success me-2"></i>Global Food Item Management
        </h2>
        <p class="text-secondary mb-0">Manage master food item catalog, prices, categories, and shelf life parameters.</p>
    </div>
    <div>
        <a href="@Url.Action("AddFood", "User")" class="btn btn-success d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-plus-circle"></i> Add Master Item
        </a>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-header bg-body-tertiary border-secondary py-3">
        <h5 class="card-title mb-0 text-light fw-semibold">Master Dishes Catalog</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-group-divider border-secondary text-secondary small text-uppercase">
                    <tr>
                        <th>Food ID</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price ($)</th>
                        <th>Serving Unit</th>
                        <th>Shelf Life</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-secondary fw-semibold">#@item.FoodId</td>
                                <td class="fw-bold text-light">@item.Name</td>
                                <td><span class="badge bg-info bg-opacity-10 text-info border border-info">@item.Category</span></td>
                                <td class="text-success fw-bold">$@item.Price.ToString("F2")</td>
                                <td>@item.Unit</td>
                                <td><span class="badge bg-secondary">@item.ShelfLifeDays Days</span></td>
                                <td class="text-end">
                                    <a href="@Url.Action("Edit", "Food", new { id = item.FoodId })" class="btn btn-sm btn-outline-info me-1">
                                        <i class="fa-solid fa-pen-to-square"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", "Food", new { id = item.FoodId })" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-4">
                                <i class="fa-solid fa-utensils display-6 mb-2 d-block opacity-50"></i>
                                No food items registered in the database.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
