@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-danger-subtle">
    <div>
        <h2 class="fw-bold mb-1 text-danger">
            <i class="fa-solid fa-user-shield me-2"></i>Master Administrator Control Center
        </h2>
        <p class="text-secondary mb-0">System-wide monitoring of user accounts, global food catalog, and total waste telemetry.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ManageUsers", "Admin")" class="btn btn-outline-info d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-users-gear"></i> User Accounts
        </a>
        <a href="@Url.Action("ManageFood", "Admin")" class="btn btn-outline-success d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-bowl-food"></i> Food Catalog
        </a>
    </div>
</div>

<!-- Admin Stat Cards Grid -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Registered Accounts</span>
                    <h2 class="display-6 fw-bold mb-0 text-info">@ViewBag.TotalUsers</h2>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                    <i class="fa-solid fa-users fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Master Food Catalog</span>
                    <h2 class="display-6 fw-bold mb-0 text-success">@ViewBag.TotalFoods</h2>
                </div>
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="fa-solid fa-utensils fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Total Waste Logs</span>
                    <h2 class="display-6 fw-bold mb-0 text-warning">@ViewBag.TotalWasteCount</h2>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="fa-solid fa-dumpster fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-semibold text-uppercase">Total Financial Loss</span>
                    <h2 class="display-6 fw-bold mb-0 text-danger">$@ViewBag.TotalFinancialLoss.ToString("F2")</h2>
                </div>
                <div class="p-3 bg-danger bg-opacity-10 text-danger rounded-3">
                    <i class="fa-solid fa-coins fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Panels & Status Grid -->
<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-header bg-body-tertiary border-secondary py-3">
                <h5 class="card-title mb-0 text-light fw-semibold">
                    <i class="fa-solid fa-sliders me-2 text-info"></i>System Management Shortcuts
                </h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush bg-transparent">
                    <a href="@Url.Action("ManageUsers", "Admin")" class="list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-bold text-info"><i class="fa-solid fa-user-pen me-2"></i>Staff & User Account Management</div>
                            <small class="text-secondary">View registered staff, adjust user roles, or manage system access.</small>
                        </div>
                        <i class="fa-solid fa-chevron-right text-secondary"></i>
                    </a>
                    <a href="@Url.Action("ManageFood", "Admin")" class="list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-bold text-success"><i class="fa-solid fa-bowl-rice me-2"></i>Global Food Item Management</div>
                            <small class="text-secondary">Edit master dish listings, shelf life parameters, and categories.</small>
                        </div>
                        <i class="fa-solid fa-chevron-right text-secondary"></i>
                    </a>
                    <a href="@Url.Action("Reports", "Admin")" class="list-group-item list-group-item-action bg-transparent text-light border-secondary d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-bold text-danger"><i class="fa-solid fa-chart-pie me-2"></i>System Waste Telemetry Reports</div>
                            <small class="text-secondary">Audit system-wide waste trends and financial loss metrics.</small>
                        </div>
                        <i class="fa-solid fa-chevron-right text-secondary"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-header bg-body-tertiary border-secondary py-3">
                <h5 class="card-title mb-0 text-light fw-semibold">
                    <i class="fa-solid fa-server me-2 text-success"></i>Infrastructure & EF Database Health
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <span class="text-secondary small fw-semibold text-uppercase">ORM Framework</span>
                    <div class="fw-bold text-light fs-5">Entity Framework 6 (.NET Framework 4.8)</div>
                </div>
                <div class="mb-3">
                    <span class="text-secondary small fw-semibold text-uppercase">Database Connection String</span>
                    <div class="p-2 bg-body-tertiary rounded font-monospace text-success border border-secondary small">
                        SmartRestaurantDB (Data Source=(LocalDb)\MSSQLLocalDB)
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 mt-4">
                    <span class="badge bg-success bg-opacity-20 text-success border border-success px-3 py-2">
                        <i class="fa-solid fa-circle-check me-1"></i> LocalDB Status: Connected & Healthy
                    </span>
                    <span class="badge bg-info bg-opacity-20 text-info border border-info px-3 py-2">
                        <i class="fa-solid fa-database me-1"></i> 6 DbSets Active
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
