<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SmartWaste Admin Portal</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Custom Theme Styling -->
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
</head>
<body class="bg-dark text-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-body-tertiary border-bottom border-danger-subtle sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-danger d-flex align-items-center gap-2" href="@Url.Action("Dashboard", "Admin")">
                    <i class="fa-solid fa-user-shield text-danger"></i>
                    <span>SmartWaste Admin 🛡️</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbarMain" aria-controls="adminNavbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="adminNavbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-light-50" href="@Url.Action("Dashboard", "Admin")">
                                <i class="fa-solid fa-chart-line me-1 text-warning"></i> Admin Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light-50" href="@Url.Action("ManageUsers", "Admin")">
                                <i class="fa-solid fa-users-gear me-1 text-info"></i> Manage Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light-50" href="@Url.Action("ManageFood", "Admin")">
                                <i class="fa-solid fa-bowl-food me-1 text-success"></i> Manage Foods
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light-50" href="@Url.Action("Reports", "Admin")">
                                <i class="fa-solid fa-file-invoice-dollar me-1 text-danger"></i> System Reports
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav mb-2 mb-lg-0 gap-2 align-items-center">
                        <li class="nav-item">
                            <span class="badge bg-danger bg-opacity-20 text-danger border border-danger px-3 py-2 rounded-pill">
                                <i class="fa-solid fa-shield-halved me-1"></i> Admin Privileges
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="@Url.Action("Dashboard", "User")">
                                <i class="fa-solid fa-arrow-left me-1"></i> Exit to User Portal
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid px-4 py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-body-tertiary border-top border-secondary-subtle py-3 text-center text-secondary small">
        <div class="container">
            <p class="mb-0">&copy; @DateTime.Now.Year - SmartRestaurantWasteManagement Administrator Control Center</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
