@model SmartRestaurantWasteManagement.Models.User
@{
    ViewBag.Title = "Profile";
}

<div style="max-width: 600px; margin: 2rem auto;">
    <div class="glass-card">
        <h2 style="margin-bottom: 1.5rem;"><i class="fa-solid fa-id-card"></i> User Profile</h2>
        <div class="form-group">
            <label class="form-label">Username</label>
            <input type="text" class="form-control-custom" value="@Model.Username" readonly />
        </div>
        <div class="form-group">
            <label class="form-label">Email</label>
            <input type="text" class="form-control-custom" value="@Model.Email" readonly />
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <input type="text" class="form-control-custom" value="@Model.Role" readonly />
        </div>
        <div class="form-group">
            <label class="form-label">Restaurant Name</label>
            <input type="text" class="form-control-custom" value="@Model.RestaurantName" readonly />
        </div>
    </div>
</div>
