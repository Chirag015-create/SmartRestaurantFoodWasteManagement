@model SmartRestaurantWasteManagement.Models.Food
@{
    ViewBag.Title = "Add Food Item";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-10 col-lg-7">
        <div class="card bg-dark text-light border-secondary shadow-lg rounded-4">
            <div class="card-header bg-body-tertiary border-secondary py-3 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold text-success">
                    <i class="fa-solid fa-square-plus me-2"></i>Add New Food Item
                </h4>
                <a href="@Url.Action("FoodList", "User")" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                </a>
            </div>

            <div class="card-body p-4">
                @using (Html.BeginForm("AddFood", "User", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="Name" class="form-label fw-medium">Food Item Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control bg-body-tertiary text-light border-secondary", placeholder = "e.g., Grilled Salmon Bowl", required = "required" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="Category" class="form-label fw-medium">Category <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Category, new SelectList(new[] { "Main Course", "Appetizer", "Dessert", "Beverage", "Ingredient" }), "-- Select Category --", new { @class = "form-select bg-body-tertiary text-light border-secondary", required = "required" })
                            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label for="Price" class="form-label fw-medium">Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-secondary border-secondary text-light">$</span>
                                @Html.TextBoxFor(m => m.Price, new { @class = "form-control bg-body-tertiary text-light border-secondary", type = "number", step = "0.01", placeholder = "14.99", required = "required" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="Unit" class="form-label fw-medium">Serving Unit <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Unit, new { @class = "form-control bg-body-tertiary text-light border-secondary", placeholder = "e.g., Portion, Kg, Plate", required = "required" })
                            @Html.ValidationMessageFor(m => m.Unit, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            <label for="ShelfLifeDays" class="form-label fw-medium">Shelf Life (Days) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.ShelfLifeDays, new { @class = "form-control bg-body-tertiary text-light border-secondary", type = "number", placeholder = "3", required = "required" })
                                <span class="input-group-text bg-secondary border-secondary text-light">Days</span>
                            </div>
                            @Html.ValidationMessageFor(m => m.ShelfLifeDays, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="Description" class="form-label fw-medium">Item Description</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control bg-body-tertiary text-light border-secondary", rows = "3", placeholder = "Provide ingredients or preparation details..." })
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("FoodList", "User")" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="fa-solid fa-check me-1"></i> Save Food Item
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
