@{
    ViewBag.Title = "Waste Analytics & Reports";
}

<div class="glass-card">
    <h2><i class="fa-solid fa-chart-pie"></i> Restaurant Waste & Sustainability Reports</h2>
    <p style="color: var(--text-secondary); margin-bottom: 2rem;">Comprehensive summary of financial losses, waste breakdown by category, and monthly trends.</p>

    <div class="stats-grid">
        <div class="stat-card">
            <div>
                <div class="stat-value">$1,240.50</div>
                <div class="stat-label">Estimated Monthly Waste Loss</div>
            </div>
            <div class="stat-icon" style="background: rgba(244, 63, 94, 0.15); color: var(--accent-rose);"><i class="fa-solid fa-dollar-sign"></i></div>
        </div>
        <div class="stat-card">
            <div>
                <div class="stat-value">34.2 %</div>
                <div class="stat-label">Waste Reduction Rate</div>
            </div>
            <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: var(--accent-green);"><i class="fa-solid fa-arrow-trend-down"></i></div>
        </div>
        <div class="stat-card">
            <div>
                <div class="stat-value">180 kg</div>
                <div class="stat-label">Food Donated to Shelters</div>
            </div>
            <div class="stat-icon" style="background: rgba(139, 92, 246, 0.15); color: var(--accent-purple);"><i class="fa-solid fa-heart"></i></div>
        </div>
    </div>
</div>
